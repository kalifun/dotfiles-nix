#!/usr/bin/env bash
set -euo pipefail

SHELLS=(
  "go-latest"
  "go-1_25"
  "go-1_24"
  "nodejs-22"
  "nodejs-20"
  "python-313"
  "python-311"
  "rust-stable"
  "rust-nightly"
  "rust-nightly-wasm"
  "lua"
  "zig"
  "zig-latest"
  "thrift"
  "nix"
)

# Templates use language family names (no version suffix)
TEMPLATE_LANGS=(
  "go"
  "nodejs"
  "python"
  "rust"
  "lua"
  "zig"
  "plain"
)

mode=$(printf 'simple\ntemplate\n' | fzf --prompt="Mode: " --height=5 --border)

if [[ -z "$mode" ]]; then
  echo "No selection made, exiting."
  exit 1
fi

if [[ "$mode" == "simple" ]]; then
  selected=$(printf '%s\n' "${SHELLS[@]}" | fzf --prompt="Select devshell: " --height=20 --border)

  if [[ -z "$selected" ]]; then
    echo "No selection made, exiting."
    exit 1
  fi

  if [[ -f .envrc ]]; then
    echo -n ".envrc already exists, overwrite? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi

  echo "use flake github:acehinnnqru/devshells#${selected}" > .envrc
  direnv allow
  echo "Created .envrc for ${selected}"

else
  selected=$(printf '%s\n' "${TEMPLATE_LANGS[@]}" | fzf --prompt="Select template: " --height=10 --border)

  if [[ -z "$selected" ]]; then
    echo "No selection made, exiting."
    exit 1
  fi

  if [[ -f flake.nix ]]; then
    echo -n "flake.nix already exists, overwrite? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi

  nix flake init -t "github:acehinnnqru/devshells#${selected}"

  if [[ -f .envrc ]]; then
    echo -n ".envrc already exists, overwrite? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi

  echo "use flake ." > .envrc
  direnv allow
  echo "Created flake.nix + .envrc for ${selected} template"
fi
