#!/usr/bin/env bash
set -euo pipefail

FLAKE="github:acehinnnqru/devshells"
SYSTEM=$(nix eval --impure --raw --expr 'builtins.currentSystem')

# Fetch available shells and templates dynamically
FLAKE_JSON=$(nix flake show "$FLAKE" --json 2>/dev/null)

# Nix 2.28+ flake show JSON nests outputs under .inventory; do not use echo here —
# bash echo may expand "\n" inside JSON strings and break parsing.
SHELLS=$(printf '%s' "$FLAKE_JSON" | jq -r ".inventory.devShells.output.children.\"$SYSTEM\".children | keys[] | select(. != \"default\")" 2>/dev/null)
TEMPLATES=$(printf '%s' "$FLAKE_JSON" | jq -r '.inventory.templates.output.children | keys[]' 2>/dev/null)


if [[ -z "$SHELLS" ]]; then
  echo "Failed to fetch devShells from $FLAKE" >&2
  exit 1
fi

mode=$(printf 'simple\ntemplate\n' | fzf --prompt="Mode: " --height=8 --border --header="simple: use remote devshell | template: init local flake.nix")

if [[ -z "$mode" ]]; then
  echo "No selection made, exiting."
  exit 1
fi

if [[ "$mode" == "simple" ]]; then
  selected=$(echo "$SHELLS" | fzf --prompt="Select devshell: " --height=20 --border)

  if [[ -z "$selected" ]]; then
    echo "No selection made, exiting."
    exit 1
  fi

  if [[ -f .envrc ]]; then
    echo -n ".envrc already exists, overwrite? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi

  echo "use flake ${FLAKE}#${selected}" > .envrc
  direnv allow
  echo "Created .envrc for ${selected}"

else
  selected=$(echo "$TEMPLATES" | fzf --prompt="Select template: " --height=10 --border)

  if [[ -z "$selected" ]]; then
    echo "No selection made, exiting."
    exit 1
  fi

  if [[ -f flake.nix ]]; then
    echo -n "flake.nix already exists, overwrite? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi

  nix flake init -t "${FLAKE}#${selected}"

  if [[ -f .envrc ]]; then
    echo -n ".envrc already exists, overwrite? [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi

  echo "use flake ." > .envrc
  direnv allow
  echo "Created flake.nix + .envrc for ${selected} template"
fi
